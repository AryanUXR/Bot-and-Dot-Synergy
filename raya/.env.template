# Copy this file to raya/.env (git-ignored) and fill in the values.
# raya/.env is read by scripts/ and image-generation/ — never commit it.

RAYA_BASE_URL=https://v1.getraya.app
RAYA_API_TOKEN=[your own Raya API key: you type it in, never paste it into chat]

# Persona images. Preferred: Vertex AI via a service account key file (path, not contents).
# The service account needs the "Agent Platform User" role (formerly "Vertex AI User").
GOOGLE_SA_KEY=[absolute path to the service account JSON, kept outside the repo]
# Fallback: AI Studio key (prepaid credits can run out — check before relying on it)
GEMINI_API_KEY=[optional AI Studio key]
