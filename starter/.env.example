# Copy to .env (git-ignored) and fill in YOUR OWN values. Type them in yourself; never paste keys into chat.
# On a host (Vercel, Netlify...), set the same names in the host's environment-variable settings instead.

VOICE_PLATFORM=raya            # raya | vapi | retell | bland | none  (or add your own adapter)
ALLOWED_PERSONAS=rinki-new-arrival,sasmita-working-mother,meena-daycare-provider
CALL_TIMEZONE=Asia/Kolkata

# Raya
RAYA_API_KEY=
RAYA_AGENT_ID=

# Vapi
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# Retell AI
RETELL_API_KEY=
RETELL_FROM_NUMBER=
RETELL_AGENT_ID=

# Bland AI
BLAND_API_KEY=
BLAND_PATHWAY_ID=
